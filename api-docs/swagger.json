  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "RODiT-JWT",
        "description": "Peer-minted JWT from POST /api/login on **this** apiEndpoint (`jwt_token` in body). Not a cookie session. Not interchangeable with IdentyClaw home JWTs or other peers' tokens."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "description": "Unified error envelope (error-handling-standard.md).",
        "required": [
          "error",
          "requestId",
          "timestamp"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Machine-readable code (SCREAMING_SNAKE_CASE)"
              },
              "message": {
                "type": "string",
                "description": "Human-readable message"
              },
              "details": {
                "type": "object",
                "additionalProperties": true,
                "nullable": true
              }
            }
          },
          "requestId": {
            "type": "string",
            "description": "ULID correlation id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "deprecated": true,
        "description": "Use ErrorResponse",
        "$ref": "#/components/schemas/ErrorResponse"
      },
      "RequestResponse": {
        "type": "object",
        "required": [
          "requestId"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "ulid",
            "description": "Unique request identifier"
          }
        }
      }
    }
  },
