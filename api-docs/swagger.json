                  "tobesignedValues",
                  "mintingfee",
                  "mintingfeeaccount"
                ],
                "properties": {
                  "tobesignedValues": {
                    "type": "object",
                    "description": "Values to be signed in the token"
                  },
                  "mintingfee": {
                    "type": "string",
                    "description": "Fee for minting the token"
                  },
                  "mintingfeeaccount": {
                    "type": "string",
