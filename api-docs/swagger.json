                  "properties": {
                    "requestId": {
                      "type": "string",
                      "format": "ulid"
                    },
                    "user": {
                      "type": "object",
                      "description": "Decoded JWT claims",
                      "properties": {
                        "sub": {
                          "type": "string",
                          "description": "Subject (user ID)"
                        },
                        "aud": {
                          "type": "string",
                          "description": "Audience"
                        },
                        "iss": {
                          "type": "string",
                          "description": "Issuer"
                        },
                        "exp": {
                          "type": "integer",
                          "description": "Expiration timestamp"
                        },
