                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/login/timestamp": {
      "get": {
        "summary": "Peer login challenge",
        "description": "Federated login step 1. Returns synchronized Unix seconds (`timestamp`) and canonical ISO-8601 (`timestamp_iso`) for the Ed25519 signing payload. Fetch a fresh pair from **this** peer immediately before each login; do not reuse challenges across peers or attempts.",
        "tags": [
          "Authentication"
        ],
        "responses": {
          "200": {
            "description": "Challenge pair",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "timestamp",
                    "timestamp_iso",
                    "requestId"
                  ],
                  "properties": {
                    "timestamp": {
                      "type": "integer"
                    },
                    "timestamp_iso": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Failed to generate challenge",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "Mint peer JWT (Passport challenge-response)",
        "description": "Federated login step 2. Ed25519 challenge-response against **this** peer. Signed payload is UTF-8 `identifier + timestamp_iso` (no separator). Identifier is Passport `roditid` or NEAR `accountid`. Provide exactly one of `timestamp` or `timestamp_iso` from the same GET /api/login/timestamp response. Returns `jwt_token` for Bearer use on this peer only.",
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "roditid",
                      "base64url_signature"
                    ],
                    "properties": {
                      "roditid": {
                        "type": "string"
                      },
                      "timestamp": {
                        "type": "integer"
                      },
                      "timestamp_iso": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "base64url_signature": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "roditid",
                      "roditid_base64url_signature"
                    ],
                    "properties": {
                      "roditid": {
                        "type": "string"
                      },
                      "timestamp": {
                        "type": "integer"
                      },
                      "timestamp_iso": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "roditid_base64url_signature": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "headers": {
              "New-Token": {
                "description": "Same JWT as jwt_token in body",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "jwt_token",
                    "requestId"
                  ],
                  "properties": {
                    "jwt_token": {
                      "type": "string"
                    },
                    "requestId": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid login payload or timestamp",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed (when SILENT_LOGIN_FAILURES is false)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
